# Database Configuration
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=library_db

# Flask Configuration
SECRET_KEY=change-this-secret-key-in-production

# Business Rules
LOAN_PERIOD_DAYS=14
FINE_PER_DAY=1.0

# SMTP Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your_personal_email@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
SMTP_FROM_EMAIL=librarymanagement@gmail.com
SMTP_FROM_NAME="Reading Room Library"
REMINDER_DAYS_BEFORE=5

